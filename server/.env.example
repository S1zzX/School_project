# Groq Cloud API key — get yours free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API key — https://aistudio.google.com/apikey
# Quote AQ.-prefixed keys: GEMINI_API_KEY="AQ.your_key_here"
GEMINI_API_KEY=your_gemini_api_key_here

# Vision provider: auto | ollama | gemini | groq
# auto = Ollama (if enabled), then Groq, then Gemini
VISION_PROVIDER=auto

# Optional cloud model overrides
# GEMINI_VISION_MODEL=gemini-2.0-flash
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Local Ollama — Gemma 4 vision (https://ollama.com)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
# RTX 5080: gemma4:26b (balanced) or gemma4:31b (largest local dense)
OLLAMA_VISION_MODEL=gemma4:26b
